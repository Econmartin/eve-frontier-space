   "published": true,
   "volume": 1.0,
   "mass": 1550.0,
   "portionSize": 10000,
   "description": "Water-bearing sulfide-rich material common in carbonaceous chondrites. Represents aqueous alteration of metal sulfides in the early solar system.\r\n\r\nRich deposits lie beneath the crust of Murk asteroids. Grist, Scale and Spar asteroids carry smaller amounts, and traces sit deep in the cores of Mire asteroids.",
   "regolith": true,
   "price": 197.0,
   "icon": "/industry/icons/77811.png"
  },
  "78426": {
