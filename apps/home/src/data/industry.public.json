   "mass": 2850.0,
   "portionSize": 10000,
   "description": "Calcium-sodium aluminosilicate feldspar crystals from basaltic crust of differentiated asteroids.\r\n\r\nMakes up most of Rind, Glaze and Marrow asteroids. Bone, Flint and Spall asteroids also carry it beneath their crust.\r\n\r\n",
   "regolith": true,
   "price": 126.0,
   "icon": "/industry/icons/77800.png"
  },
  "77810": {
