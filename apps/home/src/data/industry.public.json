   "name": "Massive Ataxite Matrix",
   "group": "Metallic Regoliths",
   "category": "Asteroid",
   "published": true,
   "volume": 1.0,
   "mass": 6925.0,
   "portionSize": 10000,
   "description": "Platinum and palladium concentrated in nickel-rich metallic grains from intermediate core zones. Forms during slow cooling of differentiated asteroid cores.\r\n\r\nFound deep in the metallic cores of Ingot and Spar asteroids. Flint and Spall asteroids hold smaller amounts beneath their crust.",
   "regolith": true,
   "price": 126.0,
   "icon": "/industry/icons/77810.png"
  },
  "77811": {
